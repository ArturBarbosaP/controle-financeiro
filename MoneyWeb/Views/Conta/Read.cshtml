@using MoneyWeb.Models.ViewModels
@using MoneyWeb.Helpers
@model ContaViewModel
@{
	ViewData["Title"] = "Visualizar Conta";
}

<div class="text-start">
	<form>
		<div class="form-floating mb-3">
			<input type="text" asp-for="Nome" class="form-control" id="txtNome" aria-describedby="nomeHelp" placeholder="" disabled readonly />
			<label for="txtNome">Nome</label>
		</div>

		<div class="form-floating mb-3">
			<input type="text" asp-for="Saldo" class="form-control" id="txtSaldo" aria-describedby="nomeHelp" placeholder="" disabled readonly />
			<label for="txtSaldo">Saldo</label>
		</div>

		<div class="row">
			<div class="col text-start">
				<a class="btn btn-warning" role="button" asp-controller="Conta" asp-action="Update" asp-route-id="@Model.Id">Editar</a>
			</div>
			<div class="col text-center">
				<a class="btn btn-danger" role="button" data-bs-toggle="modal" data-bs-target="#deleteModal">Excluir</a>
			</div>
			<div class="col text-end">
				<a class="btn btn-secondary" role="button" asp-controller="Conta" asp-action="Index">Voltar</a>
			</div>
		</div>
	</form>

	<div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="staticBackdropLabel">Excluir Categoria</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					Você realmente deseja excluir a conta @Model.Nome? <br>
					<b>Essa ação não poderá ser desfeita!</b>
				</div>
				<div class="modal-footer justify-content-between">
					<form asp-controller="Conta" asp-action="Delete" method="post">
						<button type="submit" class="btn btn-danger">Excluir</button>
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>