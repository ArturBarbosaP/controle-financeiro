@using MoneyWeb.Models.Entities
@using MoneyWeb.Models.ViewModels
@model CartaoViewModel
@{
	ViewData["Title"] = "Visualizar Cartão";
}

<div class="text-start">
	<form>
		<div class="form-floating mb-3">
			<input type="text" asp-for="Nome" class="form-control" id="txtNome" aria-describedby="nomeHelp" placeholder="" disabled readonly />
			<label for="txtNome">Nome</label>
		</div>

		<div class="form-floating mb-3">
			<select asp-for="ContaId" class="form-select" id="selectConta" aria-describedby="tipoSelectHelp" placeholder="" disabled readonly >
				<option value="@Model.ContaId">@Model.ContaNome</option>
			</select>
			<label for="selectConta">Conta</label>
		</div>

		<div class="form-floating mb-3">
			<input type="date" asp-for="DataFechamento" class="form-control" id="dtpDataFechamento" aria-describedby="nomeHelp" placeholder="" disabled readonly />
			<label for="dtpDataFechamento">Data de Fechamento</label>
		</div>

		<div class="form-floating mb-3">
			<input type="date" asp-for="DataVencimento" class="form-control" id="dtpDataVencimento" aria-describedby="nomeHelp" placeholder="" disabled readonly />
			<label for="dtpDataVencimento">Data de Vencimento</label>
		</div>

		<div class="form-floating mb-3">
			<input type="text" asp-for="Limite" class="form-control" id="txtLimite" aria-describedby="nomeHelp" placeholder="0,00" inputmode="decimal" disabled readonly />
			<label for="txtLimite">Limite</label>
		</div>

		<div class="form-floating mb-3">
			<input type="text" asp-for="LimiteDisponivel" class="form-control" id="txtLimiteDisponivel" aria-describedby="nomeHelp" placeholder="0,00" inputmode="decimal" disabled readonly />
			<label for="txtLimiteDisponivel">Limite Disponível</label>
		</div>

		<div class="form-floating mb-3">
			<input type="text" asp-for="ValorParcelado" class="form-control" id="txtValorParcelado" aria-describedby="nomeHelp" placeholder="0,00" inputmode="decimal" disabled readonly />
			<label for="txtValorParcelado">Valor Parcelado</label>
		</div>

		<div class="row">
			<div class="col text-start">
				<a class="btn btn-warning" role="button" asp-controller="Cartao" asp-action="Update" asp-route-id="@Model.Id">Editar</a>
			</div>
			<div class="col text-center">
				<a class="btn btn-danger" role="button" data-bs-toggle="modal" data-bs-target="#deleteModal">Excluir</a>
			</div>
			<div class="col text-end">
				<a class="btn btn-secondary" role="button" asp-controller="Cartao" asp-action="Index">Voltar</a>
			</div>
		</div>
	</form>

	<div class="modal fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="staticBackdropLabel">Excluir Categoria</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					Você realmente deseja excluir o cartão @Model.Nome? <br>
					<b>Essa ação não poderá ser desfeita!</b>
				</div>
				<div class="modal-footer justify-content-between">
					<form asp-controller="Cartao" asp-action="Delete" method="post">
						<input type="hidden" asp-for="Id" value="@Model.Id" />
						<button type="submit" class="btn btn-danger">Excluir</button>
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>