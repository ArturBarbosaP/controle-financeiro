@using MoneyWeb.Models.ViewModels
@model IEnumerable<CartaoViewModel>
@{
    ViewData["Title"] = "Lista de Cartões";
}

<div class="d-grid gap-2 d-md-flex justify-content-md-end">
    <a role="button" class="btn btn-primary" asp-controller="Cartao" asp-action="Create">Criar novo cartão</a>
</div>

@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Nome</th>
                <th scope="col">Conta</th>
                <th scope="col">Data de fechamento</th>
                <th scope="col">Data de vencimento</th>
                <th scope="col">Limite</th>
                <th scope="col">Limite Disponível</th>
                <th scope="col">Valor Parcelado</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cartao in Model)
            {
                <tr>
                    <th scope="row">@cartao.Id</th>
                    <td>@cartao.Nome</td>
                    <td>@cartao.ContaNome</td>
                    <td>@cartao.DataFechamento</td>
                    <td>@cartao.DataVencimento</td>
                    <td>@cartao.Limite</td>
                    <td>@cartao.LimiteDisponivel</td>
                    <td>@cartao.ValorParcelado</td>
                    <td>
                        <div class="d-grid gap-2 d-md-block" role="group" aria-label="Ações">
                            <a role="button" class="btn btn-info me-md-2" asp-controller="Cartao" asp-action="Read" asp-route-id="@cartao.Id">Visualizar</a>
                            <a role="button" class="btn btn-warning" asp-controller="Cartao" asp-action="Update" asp-route-id="@cartao.Id">Editar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h2>Nenhum cartão cadastrado!</h2>
}